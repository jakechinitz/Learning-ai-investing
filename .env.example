# AI Investing Daily - Environment Configuration
# Copy this to .env and fill in your values

# =====================
# TELEGRAM (Recommended)
# =====================
# 1. Message @BotFather on Telegram
# 2. Create bot with /newbot
# 3. Copy token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 4. Start your bot and send /start
# 5. It will reply with your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# =====================
# EMAIL (Alternative)
# =====================
# Choose one provider: gmail, resend, or sendgrid
EMAIL_PROVIDER=gmail

# For Gmail:
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# For Resend (resend.com):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=reports@yourdomain.com

# For SendGrid:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# EMAIL_FROM=reports@yourdomain.com

# Recipient email
EMAIL_TO=your.email@gmail.com

# =====================
# OPTIONAL: Stock Data
# =====================
# For real-time price fetching (optional)
# ALPHA_VANTAGE_API_KEY=your_key
# POLYGON_API_KEY=your_key
